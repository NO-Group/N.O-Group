{
  "name": "@vortex/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vortex Storage Engine — S3-compatible multi-cloud object storage with media pipeline, signed webhooks and RLS guards.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.682.0",
    "@aws-sdk/s3-request-presigner": "^3.682.0",
    "@azure/storage-blob": "^12.25.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
