# ══════════════════════════════════════════════════════════════════
#  VORTEX STORAGE ENGINE — environment template
#  Copy to `.env` next to this file. Only the blocks you enable matter;
#  unconfigured providers simply show as "not configured" in the console.
# ══════════════════════════════════════════════════════════════════

# ── core ────────────────────────────────────────────────────────────
PORT=8787
VORTEX_DATA_DIR=./vortex_data
VORTEX_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Active engine on boot: cloudflare_r2 | aws_s3 | digitalocean_spaces | gcs | azure_blob | local_disk
VORTEX_STORAGE_DRIVER=local_disk

# ── security ────────────────────────────────────────────────────────
# DEV ONLY default. In production set to false and issue JWTs with
#   iss = VORTEX_JWT_ISSUER, signed HS256 with VORTEX_JWT_SECRET.
VORTEX_AUTH_DISABLED=true
VORTEX_JWT_SECRET=change-me-in-production
VORTEX_JWT_ISSUER=vortex.no-group.org
VORTEX_ADMIN_KEY=change-me-admin-key

# Optional custom RLS rules (JSON array):
# VORTEX_RLS_RULES=[{"name":"avatars","pattern":"^buckets/user-avatars/([^/]+)(?:/|$)","claim":"sub"}]

# ── webhooks ────────────────────────────────────────────────────────
VORTEX_WEBHOOK_SECRET=whsec_change-me
# JSON array of endpoints:
# VORTEX_WEBHOOK_ENDPOINTS=[{"url":"https://api.example.com/vortex/hook","description":"prod ingest"}]

# ── multipart janitor ───────────────────────────────────────────────
VORTEX_MULTIPART_MAX_AGE_HOURS=24
VORTEX_MULTIPART_JANITOR_INTERVAL_SECONDS=900

# ── cloudflare_r2 (default managed engine) ──────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ── aws_s3 (enterprise compliance) ──────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=

# ── digitalocean_spaces (indie/staging) ─────────────────────────────
# DO_SPACES_REGION=fra1
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=
# DO_SPACES_ENDPOINT=

# ── gcs (AI/ML via S3 interoperability XML API + HMAC keys) ─────────
# GCS_HMAC_ACCESS_KEY=
# GCS_HMAC_SECRET=
# GCS_BUCKET=
# GCS_ENDPOINT=

# ── azure_blob (corporate IT) ───────────────────────────────────────
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_CONNECTION_STRING=

# ── local_disk ──────────────────────────────────────────────────────
VORTEX_LOCAL_SIGNING_SECRET=vortex-local-transfer-secret
