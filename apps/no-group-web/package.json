{
  "name": "@no-group/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/check-client.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "start:api": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test:e2e": "playwright test",
    "pages:build": "wrangler pages functions build functions --outdir .pages-functions"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "cheerio": "^1.0.0",
    "entities": "^6.0.1",
    "ipaddr.js": "^2.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "robots-parser": "^3.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@zxing/library": "^0.21.3",
    "jsqr": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
