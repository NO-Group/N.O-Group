# Server-only variables. Never add a VITE_ prefix to secrets.
BRAVE_SEARCH_API_KEY=
QUOTA_HASH_KEY=
SEARCH_DAILY_LIMIT=500
SEARCH_IP_DAILY_LIMIT=50
SEARCH_IP_MINUTE_LIMIT=6
# Set true only if your Brave subscription permits storage of results.
SEARCH_RESULT_CACHE=false
# Production Node crawler and Pages Function must share this token.
CRAWLER_SERVICE_TOKEN=
CRAWLER_ALLOWED_HOSTS=no-group.org
# Optional on-demand homepage data panels (server-only).
ALLSPORTS_API_KEY=
OPENWEATHERMAP_API_KEY=
WEATHER_DAILY_LIMIT=500
SPORTS_DAILY_LIMIT=500
