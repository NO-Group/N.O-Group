{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node",
      "@cloudflare/workers-types"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "server",
    "functions",
    "platform",
    "playwright.config.ts",
    "vitest.config.ts",
    "e2e"
  ]
}
