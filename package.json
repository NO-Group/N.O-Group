{
  "name": "no-group-vortex",
  "version": "1.0.0",
  "private": true,
  "description": "N.O Group — Vortex BaaS platform monorepo: multi-cloud storage engine + AMOLED dashboard",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace apps/vortex-server",
    "dev:dashboard": "npm run dev --workspace apps/vortex-dashboard",
    "seed": "npm run seed --workspace apps/vortex-server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "vortex",
    "baas",
    "storage",
    "multi-cloud",
    "no-group"
  ],
  "author": "N.O Group <eng@no-group.org>",
  "license": "UNLICENSED"
}
